# Copy this file to .env (git-ignored) and fill in the keys you have.
# Every variable is optional. A missing or blank API key makes that connector
# serve simulated data and log one warning at startup; nothing crashes.
# Keys are resolved in app/config.py; the legacy alias names still work, but
# the canonical name wins when both are set.

# Flask session secret. A random value is generated at startup when unset.
# SECRET_KEY=change-me

# Put Flask into testing mode (CI sets TESTING=True for pytest).
# TESTING=True

# OpenWeatherMap current weather + 5-day forecast   https://openweathermap.org/api
# legacy alias: WEATHER_API_KEY
OPENWEATHER_API_KEY=

# Alpha Vantage stock index + FX data   https://www.alphavantage.co/support/#api-key
# legacy alias: ECONOMIC_API_KEY
ALPHAVANTAGE_API_KEY=

# News API headlines used as the "social media" trend/sentiment source   https://newsapi.org/register
# legacy alias: SOCIAL_MEDIA_API_KEY
NEWSAPI_KEY=

# TomTom Traffic Flow   https://developer.tomtom.com/
# legacy alias: TRANSPORTATION_API_KEY
TOMTOM_API_KEY=
